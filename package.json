{
  "name": "enterprise-softphone",
  "version": "0.0.1",
  "private": true,
  "description": "Enterprise Softphone Platform",
  "author": "HailRase",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:dist": "electron-vite build --mode production",
    "build:win": "node scripts/check-node-version.mjs && npm run build:dist && electron-builder --win --config electron-builder.yml",
    "build:mac": "node scripts/check-node-version.mjs && npm run build:dist && electron-builder --mac --config electron-builder.yml",
    "build:linux": "node scripts/check-node-version.mjs && npm run build:dist && electron-builder --linux --config electron-builder.yml",
    "build:all": "node scripts/check-node-version.mjs && npm run build:dist && electron-builder --win --mac --linux --config electron-builder.yml",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ui:catalog": "node scripts/generate-ui-catalog.mjs",
    "ui:catalog:check": "npm run ui:catalog && git diff --exit-code docs/softphone/UI-Component-Catalog.md",
    "registry:check": "node scripts/check-registry-paths.mjs"
  },
  "dependencies": {
    "@hailrase/jssip": "^3.10.2",
    "@radix-ui/react-dialog": "^1.1.17",
    "clsx": "^2.1.1",
    "framer-motion": "^12.41.0",
    "lucide-animated": "^1.0.4",
    "lucide-react": "^1.21.0",
    "motion": "^12.42.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^9.28.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "storybook": "^8.6.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}
