{
  "name": "Axatalk",
  "version": "0.11.2",
  "private": true,
  "description": "Softphone Platform",
  "author": "Axata",
  "desktopName": "axatalk",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:icons": "python scripts/build-app-icons.py",
    "build:dist": "electron-vite build --mode production",
    "build:win": "node scripts/check-node-version.mjs && npm run build:icons && npm run build:dist && node scripts/run-electron-builder.mjs --win -c.directories.output=dist/win",
    "build:mac": "node scripts/check-node-version.mjs && npm run build:icons && npm run build:dist && node scripts/run-electron-builder.mjs --mac -c.directories.output=dist/mac",
    "build:linux": "node scripts/check-node-version.mjs && npm run build:icons && npm run build:dist && node scripts/build-linux.mjs",
    "build:all": "node scripts/check-node-version.mjs && npm run build:dist && node scripts/run-electron-builder.mjs --win --mac --linux -c.directories.output=dist/all",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.module.css\"",
    "css:types": "node scripts/generate-css-module-types.mjs",
    "typecheck": "npm run css:types && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ui:catalog": "node scripts/generate-ui-catalog.mjs",
    "ui:catalog:check": "npm run ui:catalog && git diff --exit-code docs/softphone/UI-Component-Catalog.md",
    "registry:check": "node scripts/check-registry-paths.mjs",
    "release:sync-manifest": "node scripts/sync-release-manifest.mjs",
    "release:push-distribution": "node scripts/push-distribution-repo.mjs",
    "release:update-notes": "node scripts/update-distribution-release-notes.mjs",
    "release:backfill-notes": "node scripts/backfill-distribution-release-notes.mjs",
    "release:migrate-distribution": "node scripts/migrate-distribution-releases.mjs",
    "release:preflight": "npm run test && npm run lint && npm run typecheck && npm run registry:check",
    "i18n:check": "node scripts/check-i18n-hardcoded.mjs"
  },
  "dependencies": {
    "@axatalk/protocol": "file:axatalk-sdk/packages/protocol",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react-dom": "^2.1.8",
    "@hailrase/jssip": "^3.10.2",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-toast": "^1.2.18",
    "@radix-ui/react-tooltip": "^1.2.11",
    "clsx": "^2.1.1",
    "framer-motion": "^12.41.0",
    "lucide-animated": "^1.0.4",
    "lucide-react": "^1.21.0",
    "motion": "^12.42.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7",
    "ws": "^8.18.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^9.28.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "storybook": "^8.6.14",
    "stylelint": "^17.14.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}
