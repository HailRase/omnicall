{
  "name": "@softomnitel/omnicall-kit",
  "version": "0.0.0",
  "description": "Browser client for OmniCall Desktop local protocol (OmniCallClient read path + call control)",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"import('node:fs').then((fs)=>fs.promises.rm('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@softomnitel/omnicall-protocol": "0.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
