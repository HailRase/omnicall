{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.test-d.ts",
    "examples/*/src/**/*.ts",
    "vitest.config.ts",
    "tests/**/*.ts",
    "scripts/**/*.mjs",
    "eslint.config.js"
  ]
}
