{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/infrastructure/**/*.ts",
    "src/adapters/**/*.ts",
    "src/ports/**/*.ts",
    "src/application/**/*.ts",
    "src/domain/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
